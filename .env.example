# 复制为 .env 后填入天眼查“天眼 AI”页面生成的 MCP API Key。
TYC_AUTHORIZATION=
TYC_MCP_ENDPOINT=https://mcp.tianyancha.com/mcp
TYC_CORE_ENDPOINT=https://mcp.tianyancha.com/v1/core/tools/call

# 正式 HTTPS 环境必须设置稳定随机值并将 Secure 改为 true；本地开发可留空。
APP_COOKIE_SECRET=
APP_COOKIE_SECURE=false

# API资料永久保留并标注原取得时间；默认路径由后端定位到项目目录。
# COLLECTION_DATABASE_PATH=D:/data/company/collections.sqlite3
# 同一凭据的权益范围改变时可递增作用域版本，避免沿用旧范围资料；不填写密钥。
COLLECTION_SCOPE_VERSION=1
