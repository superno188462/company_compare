    "CollectionOperationView": {
      "title": "CollectionOperationView",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "description": "当前操作标识。",
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "session_id": {
          "description": "所属会话标识。",
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "session_generation": {
          "description": "所属主体代次。",
          "minimum": 1,
          "title": "Session Generation",
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "load_page",
            "refresh_tool"
          ],
          "description": "浏览任务种类。"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ],
          "description": "任务状态。"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollectionOverview"
            },
            {
              "type": "null"
            }
          ],
          "description": "成功终态的浏览概览。"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundaryErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "失败终态的安全错误。"
        }
      },
      "required": [
        "operation_id",
        "session_id",
        "session_generation",
        "kind",
        "state",
        "result",
        "error"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "not": {
                  "type": "null"
                }
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "not": {
                  "type": "null"
                }
              },
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
